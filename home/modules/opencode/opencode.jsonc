{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["opencode-plugin-litellm@latest"],
  "enabled_providers": ["litellm", "litellm-responses"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://llm.ai.tap/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "chatgpt/gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true }
        },
        "chatgpt/gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true }
        },
        "chatgpt/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true }
        }
      }
    }
  }
}

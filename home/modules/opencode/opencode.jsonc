{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "plugins": ["@dietrichgebert/ponytail"],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "litellm", "effect": "allow" }
  ],
  "providers": {
    "litellm": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "LiteLLM",
      "settings": {
        "baseURL": "http://llm.ai.tap/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "anthropic/claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-fable-5": {
          "name": "Claude Fable 5",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "compatibility": { "cacheFormat": "anthropic" },
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 200000, "output": 64000 }
        },
        "chatgpt/gpt-6-astra": {
          "name": "GPT-6 Astra",
          "package": "@opencode/ai/providers/openai/responses",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "chatgpt/gpt-6-sol": {
          "name": "GPT-6 Sol",
          "package": "@opencode/ai/providers/openai/responses",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "chatgpt/gpt-6-luna": {
          "name": "GPT-6 Luna",
          "package": "@opencode/ai/providers/openai/responses",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "opencode-go/grok-4.7": {
          "name": "Grok 4.7 (Go)",
          "package": "@opencode/ai/providers/openai/responses",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 500000, "output": 131072 }
        },
        "opencode-go/glm-5.3": {
          "name": "GLM 5.3 (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/kimi-k3": {
          "name": "Kimi K3 (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1048576, "output": 131072 }
        },
        "opencode-go/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 384000 }
        },
        "opencode-go/mimo-v2.6-pro": {
          "name": "MiMo V2.6 Pro (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/mimo-v2.6-flash": {
          "name": "MiMo V2.6 Flash (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/minimax-m3": {
          "name": "MiniMax M3 (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 204800, "output": 131072 }
        },
        "opencode-go/hy4-preview": {
          "name": "Hy4 Preview (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/longcat-2.0": {
          "name": "LongCat 2.0 (Go)",
          "package": "@opencode/ai/providers/openai-compatible",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 1000000, "output": 131072 }
        },
        "p150/qwen3.8-27b": {
          "name": "Qwen3.8 27B (P150)",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 32768, "output": 8192 }
        },
        "nightman/Qwen3.8-Flash-Next-MTP": {
          "name": "Qwen3.8 Flash Next (local)",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"], "reasoning": { "supported": true } },
          "limit": { "context": 32768, "output": 32768 }
        }
      }
    }
  }
}

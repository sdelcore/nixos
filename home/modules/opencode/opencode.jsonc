{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "enabled_providers": ["litellm"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://llm.ai.tap/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "anthropic/claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-fable-5": {
          "name": "Claude Fable 5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 64000 }
        },
        "chatgpt/gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "tool_call": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "chatgpt/gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "tool_call": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "chatgpt/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "tool_call": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "deepseek/deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "deepseek/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "glm/glm-5.2": {
          "name": "GLM 5.2",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "kimi/kimi-k2.7-code": {
          "name": "Kimi K2.7 Code",
          "tool_call": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "nightman/Qwen3.6-35B-A3B-MTP": {
          "name": "Qwen3.6 35B A3B (local)",
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "nightman/Qwen3.6-27B-MTP": {
          "name": "Qwen3.6 27B (local)",
          "reasoning": true,
          "limit": { "context": 262144, "output": 32768 }
        },
        "nightman/Qwen3-8B": {
          "name": "Qwen3 8B (local)",
          "reasoning": true,
          "limit": { "context": 16384, "output": 8192 }
        },
        "nightman/Phi-4": {
          "name": "Phi-4 (local)",
          "limit": { "context": 16384, "output": 8192 }
        }
      }
    }
  }
}

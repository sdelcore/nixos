{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["@dietrichgebert/ponytail"],
  "enabled_providers": ["litellm"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://llm.ai.tap/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "anthropic/claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-fable-5": {
          "name": "Claude Fable 5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 64000 }
        },
        "anthropic/claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 64000 }
        },
        "chatgpt/gpt-6-astra": {
          "name": "GPT-6 Astra",
          "reasoning": true,
          "tool_call": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "chatgpt/gpt-6-sol": {
          "name": "GPT-6 Sol",
          "reasoning": true,
          "tool_call": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "chatgpt/gpt-6-luna": {
          "name": "GPT-6 Luna",
          "reasoning": true,
          "tool_call": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "options": { "forceReasoning": true },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "opencode-go/grok-4.7": {
          "name": "Grok 4.7 (Go)", "reasoning": true, "tool_call": true,
          "provider": { "npm": "@ai-sdk/openai" },
          "limit": { "context": 500000, "output": 131072 }
        },
        "opencode-go/glm-5.3": {
          "name": "GLM 5.3 (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/glm-5.3-flash": {
          "name": "GLM 5.3 Flash (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/kimi-k3": {
          "name": "Kimi K3 (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 1048576, "output": 131072 }
        },
        "opencode-go/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 1000000, "output": 384000 }
        },
        "opencode-go/mimo-v2.6-pro": {
          "name": "MiMo V2.6 Pro (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/mimo-v2.6-flash": {
          "name": "MiMo V2.6 Flash (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/minimax-m3": {
          "name": "MiniMax M3 (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 204800, "output": 131072 }
        },
        "opencode-go/hy4-preview": {
          "name": "Hy4 Preview (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        },
        "opencode-go/longcat-2.0": {
          "name": "LongCat 2.0 (Go)", "reasoning": true, "tool_call": true,
          "limit": { "context": 1000000, "output": 131072 }
        },
        "nightman/Qwen3.8-Flash-Next-MTP": {
          "name": "Qwen3.8 Flash Next (local)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 32768, "output": 32768 }
        }
      }
    }
  }
}
